{
  "name": "codex-config",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/serve-fixture.mjs",
    "build": "pnpm --dir apps/desktop build",
    "dev": "pnpm --dir apps/desktop dev",
    "dev:legacy": "tauri dev",
    "build:legacy": "tauri build",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "test:desktop": "pnpm --dir apps/desktop exec vitest run tests/components/OceanwayConfigPanel.test.tsx tests/types/sessionFixtures.test.ts",
    "preview:desktop": "pnpm --dir apps/desktop exec vite --port 3012 --host 127.0.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
