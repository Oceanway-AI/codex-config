{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-config",
  "version": "1.0.0",
  "identifier": "com.oceanway.codex-config",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "codex-config",
        "width": 820,
        "height": 560,
        "minWidth": 760,
        "minHeight": 440,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
