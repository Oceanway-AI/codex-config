{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-config",
  "version": "1.0.0",
  "identifier": "com.oceanway.codex-config",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "codex-config",
        "width": 720,
        "height": 500,
        "minWidth": 700,
        "minHeight": 490,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
